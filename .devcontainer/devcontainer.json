{
  "name": "qwen-chat",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "chat app", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "pip install -e ./backend[dev] && python scripts/generate_icons.py && python -m playwright install --with-deps chromium",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff", "ms-playwright.playwright"]
    }
  }
}

#Note what is deliberately absent: no llama-cpp-python, no model, no mobile extra. The Codespace installs dev only.
